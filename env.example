# Kopye fichye sa a rele ".env" (san .example nan bout la) epi ranpli l
# ak vrè valè ou jwenn sou tablo bò (dashboard) Upstash ou a:
# https://console.upstash.com → chwazi database ou a → "REST API" seksyon

UPSTASH_REDIS_REST_URL=https://xxxxx-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AxxxXXXXxxxxXXXXxxxxXXXX

# Opsyonèl — pò sèvè a ap kouri sou li (default 4000 si w pa mete anyen)
# PORT=4000
